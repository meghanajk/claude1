    "short1": {
      "title": "THE POWER OF THE CROWD",
      "leadIn": 0.15,
      "tail": 2.2,
      "highlights": {
        "red": ["wrong", "secretly", "alone", "crowd"],
        "yellow": ["Asch", "obvious", "experiment", "reference", "group", "Many", "right", "everyone"]
      },
      "scenes": [
        {"id": "s1main", "music": "suspense", "lines": [
          {"id": "a1", "text": "Would you give the wrong answer just because everyone else did?", "pause": 0.4},
          {"id": "a2", "text": "In the 1950s, psychologist Solomon Asch ran a simple experiment.", "say": "In the nineteen fifties, psychologist Solomon Asch ran a simple experiment.", "pause": 0.3},
          {"id": "a3", "text": "Which line matches the reference line?", "pause": 0.4},
          {"id": "a4", "text": "The answer was obvious.", "pause": 0.3},
          {"id": "a5", "text": "But everyone else in the room was secretly working with the researcher.", "pause": 0.3},
          {"id": "a6", "text": "And one by one, they all gave the same wrong answer.", "pause": 0.5},
          {"id": "a7", "text": "So what did the real participants do?", "pause": 0.5},
          {"id": "a8", "text": "Many of them went along with the group at least once.", "pause": 0.3},
          {"id": "a9", "text": "Not because they couldn't see the answer.", "pause": 0.2},
          {"id": "a10", "text": "Because they didn't want to stand alone.", "pause": 0.7},
          {"id": "a11", "text": "Sometimes, the crowd isn't right.", "rate": "-6%", "pause": 0.3},
          {"id": "a12", "text": "It's just the crowd.", "rate": "-8%", "pause": 0.0}
        ]}
      ],
