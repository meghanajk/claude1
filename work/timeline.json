{
 "total": 47.43333333333333,
 "frames": 1423,
 "lines": [
  {
   "n": 1,
   "start": 0.4,
   "end": 6.518,
   "text": "This Telugu man saved millions of lives, and almost nobody knows his name."
  },
  {
   "n": 2,
   "start": 6.818,
   "end": 8.462,
   "text": "Yellapragada Subbarow."
  },
  {
   "n": 3,
   "start": 8.762,
   "end": 11.558,
   "text": "He found how our body makes energy."
  },
  {
   "n": 4,
   "start": 11.857,
   "end": 15.644,
   "text": "He helped create medicines that still fight cancer."
  },
  {
   "n": 5,
   "start": 15.944,
   "end": 18.644,
   "text": "But his own life was full of pain."
  },
  {
   "n": 6,
   "start": 18.944,
   "end": 22.811,
   "text": "Born poor. Lost his brothers to disease."
  },
  {
   "n": 7,
   "start": 23.111,
   "end": 26.518,
   "text": "He sailed to America with almost no money."
  },
  {
   "n": 8,
   "start": 26.818,
   "end": 31.459,
   "text": "Night job in a hospital. Day class at Harvard."
  },
  {
   "n": 9,
   "start": 31.759,
   "end": 37.284,
   "text": "He gave the world answers. Harvard gave him no permanent job."
  },
  {
   "n": 10,
   "start": 37.584,
   "end": 39.412,
   "text": "He kept working anyway."
  },
  {
   "n": 11,
   "start": 39.712,
   "end": 41.902,
   "text": "He died at just 53."
  },
  {
   "n": 12,
   "start": 42.902,
   "end": 45.929,
   "text": "The world forgot him. Don't."
  }
 ]
}